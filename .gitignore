# ---- LaTeX ----
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
# latexmkrc puts LaTeX output in docs/build/, which the `build/` rule below
# already covers. Nothing in there is versioned: it is all regenerable with
# `latexmk -pdf Main.tex`. When the report is actually handed in, the finished
# PDF gets committed deliberately with `git add -f`, not by an ignore exception
# (a negation cannot re-include a file inside an ignored directory anyway).

# ---- C++ / CMake ----
build/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
compile_commands.json
install_manifest.txt
Testing/
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.pdb
*.ilk
*.gcda
*.gcno
*.gcov
*.profraw
*.profdata
coverage/
vcpkg_installed/
_deps/

# ---- Test artefacts ----
# Captures and generated certificate material for the local harness. Regenerated
# by the harness scripts; keys must never be committed.
captures/
*.pcap
*.pcapng
*.key
*.pem
*.crt
*.csr
*.p12
results/

# ---- Editors and OS ----
.vscode/
.idea/
.cache/
*.swp
.DS_Store
Thumbs.db

# The built documentation PDF is tracked so the report can be read without a
# LaTeX toolchain. Everything else latexmk produces stays out of git.
!docs/build/Main.pdf
